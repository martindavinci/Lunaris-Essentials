<?xml version="1.0" encoding="utf-8"?>
<!-- From Android 12 allowBackup=false only covers the cloud: device transfer needs these rules. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
